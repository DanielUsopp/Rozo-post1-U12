<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mapeo JPA de la clase de dominio SolicitudReembolso.
  Va en XML para que el paquete dominio no tenga anotaciones de jakarta.persistence.
  Los nombres de columna los genera Spring (empleadoId -> empleado_id).
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

    <entity class="com.empresa.reembolsos.dominio.SolicitudReembolso" access="FIELD">
        <table name="solicitud_reembolso"/>
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="categoria">
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="montoSolicitado">
                <column precision="14" scale="2"/>
            </basic>
            <basic name="montoAprobado">
                <column precision="14" scale="2"/>
            </basic>
            <basic name="estado">
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
